# Copy this file to .env and fill in real values.
# Do NOT commit your real .env file to GitHub.

# Local dev: SQLite file. For Vercel/production, Vercel auto-creates
# POSTGRES_URL when you connect the Vercel Postgres database.
# For local dev with Postgres, paste the same connection string here:
#   POSTGRES_URL=postgres://...Vercel-Postgres-connection-string...
#
# For local dev with SQLite (simpler, no Postgres needed), use:
POSTGRES_URL=postgres://user:password@localhost:5432/python_exam_prep
# And run a local Postgres — OR change the Prisma provider back to "sqlite"
# in prisma/schema.prisma and use: POSTGRES_URL=file:./db/custom.db

# Generate a long random string for production:
#   openssl rand -base64 32
NEXTAUTH_SECRET=dev-only-secret-please-change-in-production

# Your app's public URL.
# Local dev:  http://localhost:3000
# Vercel:     https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Ads / monetization (optional)
# ---------------------------------------------------------------------------
# Choose one network: "adsense" | "adsterra" | "none"
# Default is "none" — placeholders are shown instead of real ads.
NEXT_PUBLIC_AD_NETWORK=none

# Google AdSense — get your publisher ID at https://www.google.com/adsense
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=

# AdSense ad unit slot IDs — one per ad slot location.
# Create these in your AdSense dashboard (My Ads > Ad units > New ad unit).
# Format: 1234567890 (10-digit number)
NEXT_PUBLIC_ADSENSE_SLOT_LANDING_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_CHAPTER_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_EXAM_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_PRACTICE_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FLASHCARDS_BOTTOM=

# Adsterra — get your placement keys at https://adsterra.com
# Create separate placements for each location; copy the key from the embed code.
NEXT_PUBLIC_ADSTERRA_KEY_LANDING_TOP=
NEXT_PUBLIC_ADSTERRA_KEY_LANDING_SIDEBAR=
NEXT_PUBLIC_ADSTERRA_KEY_CHAPTER_BOTTOM=
NEXT_PUBLIC_ADSTERRA_KEY_DASHBOARD_SIDEBAR=
NEXT_PUBLIC_ADSTERRA_KEY_EXAM_BOTTOM=
NEXT_PUBLIC_ADSTERRA_KEY_PRACTICE_SIDEBAR=
NEXT_PUBLIC_ADSTERRA_KEY_FLASHCARDS_BOTTOM=

# Monetag — get ad codes from https://monetag.com dashboard.
# For each slot, set the env var to "scriptURL,zoneID".
# Monetag assigns a different CDN URL per zone (e.g., nap5k.com, al5sm.com,
# n6wxm.com), so each slot needs its own pair.
#
# Example (from your Monetag dashboard):
#   NEXT_PUBLIC_MONETAG_LANDING_TOP=https://nap5k.com/tag.min.js,11916702
#
# Format note:
#   - Use only banner-type zones (script src ends with /tag.min.js) for these
#     inline slots. Vignette (/vignette.min.js) and direct-link formats
#     (https://omg10.com/...) don't render inline and will be ignored.
NEXT_PUBLIC_MONETAG_LANDING_TOP=
NEXT_PUBLIC_MONETAG_LANDING_SIDEBAR=
NEXT_PUBLIC_MONETAG_CHAPTER_BOTTOM=
NEXT_PUBLIC_MONETAG_DASHBOARD_SIDEBAR=
NEXT_PUBLIC_MONETAG_EXAM_BOTTOM=
NEXT_PUBLIC_MONETAG_PRACTICE_SIDEBAR=
NEXT_PUBLIC_MONETAG_FLASHCARDS_BOTTOM=
